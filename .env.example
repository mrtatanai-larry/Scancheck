# ScanCheck runtime configuration
SCANCHECK_HOST=0.0.0.0
SCANCHECK_BOOTSTRAP_ADMIN=true
SCANCHECK_DEFAULT_ADMIN_USERNAME=admin
SCANCHECK_DEFAULT_ADMIN_PASSWORD=admin111

# Runtime directories
SCANCHECK_RUNTIME_ROOT=.runtime
SCANCHECK_DATA_DIR=.runtime/data
SCANCHECK_LOG_DIR=.runtime/logs
SCANCHECK_TMP_DIR=.runtime/tmp

# Optional explicit files
# SCANCHECK_DB_PATH=.runtime/data/scancheck.db
# SCANCHECK_JWT_SECRET_FILE=.runtime/data/.jwt_secret
# SCANCHECK_PORT_FILE=.runtime/current_port.txt

# OMR/OCR service locations
# SCANCHECK_OMR_SERVICE_DIR=services/omr-python
# SCANCHECK_OMRCHECKER_ROOT=services/omrchecker/OMRChecker-master/OMRChecker-master
# SCANCHECK_PYTHON=/usr/bin/python3
# SCANCHECK_UPLOADS_DEBUG_DIR=.runtime/data/uploads/debug
